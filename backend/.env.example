# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on
PORT=3000

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Key required by the owner admin screen (#/admin). Keep it private.
ADMIN_KEY=replace-with-your-own-admin-key

# Comma separated list of allowed browser origins, or * for any
CORS_ORIGIN=*

# SQLite file location (relative paths resolve from backend/)
DB_FILE=quickcrave.db

# How long a login lasts
TOKEN_TTL=30d
